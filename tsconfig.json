{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      // Stories and Storybook read package sources directly, so they need no
      // build step. Published packages resolve each other through dist/.
      "@charlotte-ui/labs/*": ["./packages/labs/src/*"],
      "@charlotte-ui/*": ["./packages/*/src"]
    }
  },
  "include": ["stories", ".storybook", "packages/*/src"]
}
